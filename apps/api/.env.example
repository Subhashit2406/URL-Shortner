# .env.example -- Reference configuration for Notification Service
APP_ENV=development      # REQUIRED. One of: development, staging, production
PORT=8000                 # REQUIRED. Integer port number
DATABASE_URL=postgres://postgres:postgres@localhost:5432/upsk_sdf # REQUIRED connection string
REDIS_URL=redis://localhost:6379                                   # OPTIONAL redis URL
JWT_SECRET=replace-me-locally-secret-key-32-chars-long             # REQUIRED jwt signing secret
ADMIN_API_KEY=dev_admin_api_key_secret_123                        # REQUIRED admin key
CORS_ORIGIN=*             # OPTIONAL allowed origin
LOG_LEVEL=info            # OPTIONAL log level